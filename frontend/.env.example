# 复制本文件为 .env 并填入真实密钥(.env 已被 .gitignore 排除,不会提交)
#
# 密钥取值优先级:「地图管理」页保存的服务端配置(推荐,全浏览器生效)→ 本机 localStorage → 本文件。
# 在页面保存过某项后,本文件的对应值即被覆盖;将页面中该项清空保存可恢复使用本文件配置。

# 百度地图 AK(浏览器端 JavaScript API GL,https://lbsyun.baidu.com 控制台申请)
VITE_BMAP_AK=

# 高德地图 JS API 2.0(https://console.amap.com 申请,需 Key + 安全密钥)
VITE_AMAP_KEY=
VITE_AMAP_SEC=

# 天地图浏览器端 tk(https://console.tianditu.gov.cn 申请)
VITE_TDT_KEY=
